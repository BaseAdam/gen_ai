# Copy to .env and fill in. Only the first two are required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional (defaults shown)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_RETRY_ATTEMPTS=3
# GEMINI_JUDGE_MODEL=            # model for the LLM judge; falls back to GEMINI_MODEL
# DATABASE_URL=postgresql://offers:offers@localhost:5432/offers
# RAG_MIN_SCORE=0.53
# RAG_RERANK=true
# LOG_JSON=false
